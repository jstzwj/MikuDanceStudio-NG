# Keep clang-format's LF output stable across Windows checkouts.
.clang-format text eol=lf
.vscode/*.json text eol=lf
include/mikudancestudio/*.h text eol=lf
include/mikudancestudio/*.hpp text eol=lf
src/**/*.cpp text eol=lf
src/**/*.hpp text eol=lf
src/**/*.inc text eol=lf
src/**/*.mm text eol=lf
tests/*.cpp text eol=lf
tests/*.hpp text eol=lf

# Preserve upstream license files byte for byte, including their whitespace.
res/licenses/Qt/*.txt -text -whitespace
