# Headless production frontend gates; native Windows metadata is an independent oracle.
function(mds_add_mme_tests)
    add_executable(mme_legacy_source_test tests/mme_legacy_source_test.cpp)
    target_link_libraries(mme_legacy_source_test PRIVATE mikudancestudio_mme_frontend)
    target_compile_definitions(mme_legacy_source_test PRIVATE MDS_TEST_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
    add_test(NAME mme_legacy_source COMMAND mme_legacy_source_test)
    add_executable(mme_standard_parameters_test tests/mme_standard_parameters_test.cpp)
    target_link_libraries(mme_standard_parameters_test PRIVATE mikudancestudio_mme_runtime)
    add_test(NAME mme_standard_parameters COMMAND mme_standard_parameters_test)
    add_executable(mme_scene_plan_test tests/mme_scene_plan_test.cpp)
    target_link_libraries(mme_scene_plan_test PRIVATE mikudancestudio_mme_runtime)
    add_test(NAME mme_scene_plan COMMAND mme_scene_plan_test)
    add_executable(mme_definition_test tests/mme_definition_test.cpp)
    target_link_libraries(mme_definition_test PRIVATE mikudancestudio_mme_frontend)
    target_compile_definitions(mme_definition_test PRIVATE MDS_TEST_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
    add_test(NAME mme_definition COMMAND mme_definition_test)
    set_tests_properties(mme_legacy_source mme_standard_parameters mme_scene_plan mme_definition
        PROPERTIES LABELS "p5;headless;portable")
    foreach(kind IN ITEMS defaults pool frame)
        add_executable(mme_parameter_${kind}_test tests/mme_parameter_${kind}_test.cpp)
        target_link_libraries(mme_parameter_${kind}_test PRIVATE mikudancestudio_mme_runtime)
        add_test(NAME mme_parameter_${kind} COMMAND mme_parameter_${kind}_test "${CMAKE_CURRENT_BINARY_DIR}/mme-${kind}.json")
        set_tests_properties(mme_parameter_${kind} PROPERTIES LABELS "p5;headless;portable")
    endforeach()
    add_executable(mme_schedule_test tests/mme_schedule_test.cpp)
    target_link_libraries(mme_schedule_test PRIVATE mikudancestudio_mme_runtime mikudancestudio_rhi)
    target_compile_definitions(mme_schedule_test PRIVATE MDS_TEST_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
    add_test(NAME mme_schedule COMMAND mme_schedule_test "${CMAKE_CURRENT_BINARY_DIR}/mme-schedule.json" "${MDS_DXC}")
    set_tests_properties(mme_schedule PROPERTIES LABELS "p5;headless;portable")
    foreach(kind IN ITEMS assignment targets)
        add_executable(mme_${kind}_test tests/mme_${kind}_test.cpp)
        target_link_libraries(mme_${kind}_test PRIVATE mikudancestudio_mme_runtime)
        target_compile_definitions(mme_${kind}_test PRIVATE MDS_TEST_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
        add_test(NAME mme_${kind} COMMAND mme_${kind}_test)
        set_tests_properties(mme_${kind} PROPERTIES LABELS "p5;headless;portable")
    endforeach()
    if(MDS_DXC)
        add_test(NAME mme_frontend_cli COMMAND ${Python3_EXECUTABLE}
            "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_effect_cli.py" --program $<TARGET_FILE:mds_effect_cli>
            --dxc "${MDS_DXC}" --source "${CMAKE_CURRENT_SOURCE_DIR}" --output "${CMAKE_CURRENT_BINARY_DIR}/mme-cli")
        add_test(NAME mme_frontend_dependencies COMMAND ${Python3_EXECUTABLE}
            "${CMAKE_CURRENT_SOURCE_DIR}/tools/audit_model_runtime.py" --program $<TARGET_FILE:mds_effect_cli>
            --manifest "${CMAKE_CURRENT_BINARY_DIR}/generated/mme_frontend_targets.json"
            --stage P5 --output "${CMAKE_CURRENT_BINARY_DIR}/mme-dependencies.json")
        set_tests_properties(mme_frontend_cli mme_frontend_dependencies PROPERTIES LABELS "p5;headless;portable" TIMEOUT 120)
        add_executable(mme_source_test tests/mme_source_test.cpp)
        target_link_libraries(mme_source_test PRIVATE mikudancestudio_mme_frontend)
        add_test(NAME mme_source COMMAND mme_source_test "${MDS_DXC}" "${CMAKE_CURRENT_BINARY_DIR}/mme-source")
        set_tests_properties(mme_source PROPERTIES LABELS "p5;headless;portable" TIMEOUT 90)
        # Microsoft shipped this independent FX9 metadata oracle only for x86/x64.
        # ARM64 still executes the portable frontend/semantic gates below.
        if(WIN32 AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$"
           AND NOT CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
            set(MDS_D3DX_ORACLE "" CACHE FILEPATH "Independent D3DX metadata oracle runtime (test only)")
            add_executable(mme_parameter_native_test tests/mme_parameter_native_test.cpp)
            target_link_libraries(mme_parameter_native_test PRIVATE mikudancestudio_mme_runtime d3d9)
            target_include_directories(mme_parameter_native_test PRIVATE third_party/mmeffect/include)
            add_test(NAME mme_parameter_native COMMAND mme_parameter_native_test "${MDS_D3DX_ORACLE}" "${CMAKE_CURRENT_SOURCE_DIR}")
            set_tests_properties(mme_parameter_native PROPERTIES LABELS "p5;headless;native-reference" TIMEOUT 90)
            add_executable(mme_frontend_native_test tests/mme_frontend_native_test.cpp)
            target_link_libraries(mme_frontend_native_test PRIVATE mikudancestudio_mme_frontend d3dcompiler)
            target_include_directories(mme_frontend_native_test PRIVATE third_party/mmeffect/include)
            add_test(NAME mme_frontend_native COMMAND mme_frontend_native_test "${MDS_DXC}" "${CMAKE_CURRENT_SOURCE_DIR}" "${MDS_D3DX_ORACLE}")
            set_tests_properties(mme_frontend_native PROPERTIES LABELS "p5;headless;native-reference" TIMEOUT 90)
        endif()
        if(MIKUDANCESTUDIO_RHI_VULKAN OR MIKUDANCESTUDIO_RHI_METAL)
            add_executable(mme_shader_tool_test tests/shader_compiler_test.cpp)
            target_link_libraries(mme_shader_tool_test PRIVATE mikudancestudio_rhi)
            add_test(NAME mme_shader_tool COMMAND mme_shader_tool_test)
            set_tests_properties(mme_shader_tool PROPERTIES LABELS "p5;headless;portable" TIMEOUT 120)
        endif()
    endif()
endfunction()
