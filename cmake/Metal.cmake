if(NOT APPLE)
    message(FATAL_ERROR "The native Metal backend requires macOS")
endif()
enable_language(OBJCXX)
include(FetchContent)
set(SPIRV_CROSS_STATIC ON CACHE BOOL "" FORCE)
set(SPIRV_CROSS_SHARED OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_GLSL ON CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_MSL ON CACHE BOOL "" FORCE)
set(SPIRV_CROSS_CLI OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_HLSL OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_CPP OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_REFLECT OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_C_API OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_UTIL OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_SKIP_INSTALL ON CACHE BOOL "" FORCE)
FetchContent_Declare(spirv_cross
    URL https://codeload.github.com/KhronosGroup/SPIRV-Cross/tar.gz/a0fba56c34a6700f1724bf9b751da5b488a3775c
    URL_HASH SHA256=1e79592b0a498ffb854f7d71e0d5811fcedb87a25201644bbf5dbba438e01264)
FetchContent_MakeAvailable(spirv_cross)
target_sources(mikudancestudio_rhi PRIVATE src/render/rhi_metal.mm)
set_target_properties(mikudancestudio_rhi PROPERTIES OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED YES)
target_compile_options(mikudancestudio_rhi PRIVATE $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>)
target_compile_definitions(mikudancestudio_rhi PUBLIC MIKUDANCESTUDIO_RHI_METAL=1)
target_link_libraries(mikudancestudio_rhi PRIVATE spirv-cross-msl "-framework Metal" "-framework Foundation" "-framework QuartzCore")
