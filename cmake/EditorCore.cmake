function(mds_add_editor_core)
    if(TARGET mikudancestudio_editor_core)
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    add_library(mikudancestudio_editor_core STATIC
        "${root}/src/editor/editor_session.cpp" "${root}/src/editor/editor_motion.cpp"
        "${root}/src/editor/editor_interpolation.cpp")
    target_sources(mikudancestudio_editor_core PRIVATE "${root}/src/editor/editor_selection.cpp")
    target_sources(mikudancestudio_editor_core PRIVATE "${root}/src/editor/editor_pose.cpp"
        "${root}/src/editor/editor_history.cpp" "${root}/src/editor/editor_frame_line.cpp")
    target_sources(mikudancestudio_editor_core PRIVATE "${root}/src/editor/editor_navigation.cpp"
        "${root}/src/editor/editor_bone_drag.cpp")
    target_link_libraries(mikudancestudio_editor_core PUBLIC mikudancestudio_scene_runtime mikudancestudio_images)
    target_compile_features(mikudancestudio_editor_core PUBLIC cxx_std_17)
    if(MSVC)
        target_compile_options(mikudancestudio_editor_core PRIVATE /utf-8 /fp:precise)
    else()
        target_compile_options(mikudancestudio_editor_core PRIVATE -ffp-contract=off)
    endif()
    if(BUILD_TESTING)
        add_executable(editor_physics_continuity_test "${root}/tests/editor_physics_continuity_test.cpp")
        target_link_libraries(editor_physics_continuity_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_physics_continuity COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_physics_continuity_test>)
        set_tests_properties(editor_physics_continuity PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_clipboard_test "${root}/tests/editor_clipboard_test.cpp")
        target_link_libraries(editor_clipboard_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_clipboard COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_clipboard_test>)
        set_tests_properties(editor_clipboard PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_registration_test "${root}/tests/editor_registration_test.cpp")
        target_link_libraries(editor_registration_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_registration COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_registration_test>)
        set_tests_properties(editor_registration PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_auto_interpolation_test "${root}/tests/editor_auto_interpolation_test.cpp")
        target_link_libraries(editor_auto_interpolation_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_auto_interpolation COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_auto_interpolation_test>)
        set_tests_properties(editor_auto_interpolation PROPERTIES LABELS "headless;portable;p4;oracle" TIMEOUT 120)
        add_executable(editor_frame_line_test "${root}/tests/editor_frame_line_test.cpp")
        target_link_libraries(editor_frame_line_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_frame_line COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_frame_line_test>)
        set_tests_properties(editor_frame_line PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_layout_test "${root}/tests/editor_layout_test.cpp")
        target_link_libraries(editor_layout_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_layout COMMAND editor_layout_test)
        set_tests_properties(editor_layout PROPERTIES LABELS "headless;portable;p4;oracle" TIMEOUT 30)
        add_executable(editor_bone_drag_test "${root}/tests/editor_bone_drag_test.cpp")
        target_link_libraries(editor_bone_drag_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_bone_drag COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_bone_drag_test>)
        set_tests_properties(editor_bone_drag PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_mode_test "${root}/tests/editor_mode_test.cpp")
        target_link_libraries(editor_mode_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_mode COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_mode_test>)
        set_tests_properties(editor_mode PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_playback_test "${root}/tests/editor_playback_test.cpp")
        target_link_libraries(editor_playback_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_playback COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_playback_test>)
        set_tests_properties(editor_playback PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_navigation_test "${root}/tests/editor_navigation_test.cpp")
        target_link_libraries(editor_navigation_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_navigation COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_navigation_test>)
        set_tests_properties(editor_navigation PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_selection_test "${root}/tests/editor_selection_test.cpp")
        target_link_libraries(editor_selection_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_selection COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_selection_test>)
        set_tests_properties(editor_selection PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
            add_executable(editor_auxiliary_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_auxiliary_oracle_test.cpp")
            target_compile_definitions(editor_auxiliary_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_auxiliary_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_clipboard_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_clipboard_oracle_test.cpp")
            target_compile_definitions(editor_clipboard_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_clipboard_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(bone_key_interpolation_oracle_test EXCLUDE_FROM_ALL "${root}/tests/bone_key_interpolation_oracle_test.cpp")
            target_compile_definitions(bone_key_interpolation_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_include_directories(bone_key_interpolation_oracle_test PRIVATE "${root}/include")
            target_compile_features(bone_key_interpolation_oracle_test PRIVATE cxx_std_17)
            target_link_libraries(bone_key_interpolation_oracle_test PRIVATE bcrypt)
            add_executable(editor_frame_line_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_frame_line_oracle_test.cpp")
            target_compile_definitions(editor_frame_line_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_frame_line_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_layout_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_layout_oracle_test.cpp")
            target_compile_definitions(editor_layout_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_layout_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_scene_axis_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_scene_axis_oracle_test.cpp")
            target_compile_definitions(editor_scene_axis_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_scene_axis_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_header_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_header_oracle_test.cpp")
            target_compile_definitions(editor_header_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_header_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_axis_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_axis_oracle_test.cpp")
            target_compile_definitions(editor_axis_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_axis_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_bone_drag_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_bone_drag_oracle_test.cpp")
            target_compile_definitions(editor_bone_drag_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_bone_drag_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_playback_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_playback_oracle_test.cpp")
            target_compile_definitions(editor_playback_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_playback_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_history_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_history_oracle_test.cpp")
            target_compile_definitions(editor_history_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_history_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_bone_scale_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_bone_scale_oracle_test.cpp")
            target_compile_definitions(editor_bone_scale_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_bone_scale_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_physics_key_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_physics_key_oracle_test.cpp")
            target_compile_definitions(editor_physics_key_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_physics_key_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_model_order_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_model_order_oracle_test.cpp")
            target_compile_definitions(editor_model_order_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_model_order_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
            add_executable(editor_camera_oracle_test EXCLUDE_FROM_ALL "${root}/tests/editor_camera_oracle_test.cpp")
            target_compile_definitions(editor_camera_oracle_test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(editor_camera_oracle_test PRIVATE mikudancestudio_editor_core bcrypt)
        endif()
        add_executable(editor_history_test "${root}/tests/editor_history_test.cpp")
        target_link_libraries(editor_history_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_history COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_history_test>)
        set_tests_properties(editor_history PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_pose_test "${root}/tests/editor_pose_test.cpp")
        target_link_libraries(editor_pose_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_pose COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_pose_test>)
        set_tests_properties(editor_pose PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
        add_executable(editor_session_test "${root}/tests/editor_session_test.cpp")
        target_link_libraries(editor_session_test PRIVATE mikudancestudio_editor_core)
        add_test(NAME editor_session COMMAND ${Python3_EXECUTABLE} "${root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:editor_session_test>)
        set_tests_properties(editor_session PROPERTIES LABELS "headless;portable;p4" TIMEOUT 120)
    endif()
endfunction()
