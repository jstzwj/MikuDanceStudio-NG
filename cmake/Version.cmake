# VERSION is the sole editable NG product version (major.minor.patch).
set(mds_version_file "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mds_version_file}")
file(READ "${mds_version_file}" MDS_VERSION)
string(STRIP "${MDS_VERSION}" MDS_VERSION)
if(NOT MDS_VERSION MATCHES "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$")
    message(FATAL_ERROR "VERSION must have the form major.minor.patch without leading zeros")
endif()
set(MDS_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(MDS_VERSION_MINOR "${CMAKE_MATCH_2}")
set(MDS_VERSION_PATCH "${CMAKE_MATCH_3}")
foreach(component MAJOR MINOR PATCH)
    if(MDS_VERSION_${component} GREATER 65535)
        message(FATAL_ERROR "VERSION ${component} exceeds the Windows version-resource limit")
    endif()
endforeach()
