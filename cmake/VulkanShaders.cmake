find_path(MDS_VULKAN_INCLUDE vulkan/vulkan.h HINTS "$ENV{VULKAN_SDK}/Include" REQUIRED)
target_sources(mikudancestudio_rhi PRIVATE src/render/rhi_vulkan.cpp src/platform/vulkan_surface.cpp)
target_include_directories(mikudancestudio_rhi PRIVATE "${MDS_VULKAN_INCLUDE}" "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_compile_definitions(mikudancestudio_rhi PUBLIC MIKUDANCESTUDIO_RHI_VULKAN=1)
target_link_libraries(mikudancestudio_rhi PRIVATE ${CMAKE_DL_LIBS})
if(WIN32)
    target_link_libraries(mikudancestudio_rhi PRIVATE user32)
endif()

if(UNIX AND NOT APPLE)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(MDS_XCB IMPORTED_TARGET xcb)
    pkg_check_modules(MDS_WAYLAND IMPORTED_TARGET wayland-client)
    if(MDS_XCB_FOUND)
        target_link_libraries(mikudancestudio_rhi PRIVATE PkgConfig::MDS_XCB)
        target_compile_definitions(mikudancestudio_rhi PRIVATE MDS_SURFACE_XCB=1)
    endif()
    if(MDS_WAYLAND_FOUND)
        target_link_libraries(mikudancestudio_rhi PRIVATE PkgConfig::MDS_WAYLAND)
        target_compile_definitions(mikudancestudio_rhi PRIVATE MDS_SURFACE_WAYLAND=1)
    endif()
endif()
