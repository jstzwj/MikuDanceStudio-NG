add_executable(mme_shader_layout_test tests/mme_shader_layout_test.cpp)
target_link_libraries(mme_shader_layout_test PRIVATE mikudancestudio_mme_render)
target_compile_definitions(mme_shader_layout_test PRIVATE MDS_TEST_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
add_test(NAME mme_shader_layout COMMAND mme_shader_layout_test "${MDS_DXC}")
set_tests_properties(mme_shader_layout PROPERTIES LABELS "mme-execution;headless;portable" TIMEOUT 180)
add_executable(mme_render_gpu_test tests/mme_render_gpu_test.cpp)
target_link_libraries(mme_render_gpu_test PRIVATE mikudancestudio_mme_render)
target_compile_definitions(mme_render_gpu_test PRIVATE MDS_TEST_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
set(mme_apis "")
if(WIN32 AND MIKUDANCESTUDIO_RHI_D3D11)
    list(APPEND mme_apis dx11-software)
endif()
if(WIN32 AND MIKUDANCESTUDIO_RHI_D3D12)
    list(APPEND mme_apis dx12-software)
endif()
if(MIKUDANCESTUDIO_RHI_VULKAN)
    list(APPEND mme_apis vulkan-software)
endif()
if(MIKUDANCESTUDIO_RHI_METAL)
    list(APPEND mme_apis metal)
endif()
foreach(api IN LISTS mme_apis)
    add_test(NAME mme_execution_${api} COMMAND mme_render_gpu_test ${api} "${MDS_DXC}" "${CMAKE_CURRENT_BINARY_DIR}/mme-execution/${api}")
    set_tests_properties(mme_execution_${api} PROPERTIES LABELS "mme-execution;offscreen" TIMEOUT 240 RUN_SERIAL TRUE)
endforeach()
