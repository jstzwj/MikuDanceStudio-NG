// The shell reads this resource without starting Qt or loading its image plugins.
100 ICON "@root@/res/assets/app.ico"

#include <winver.h>
1 VERSIONINFO
 FILEVERSION @MDS_VERSION_MAJOR@,@MDS_VERSION_MINOR@,@MDS_VERSION_PATCH@,0
 PRODUCTVERSION @MDS_VERSION_MAJOR@,@MDS_VERSION_MINOR@,@MDS_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MikuDanceStudio-NG\0"
            VALUE "FileVersion", "@MDS_VERSION@\0"
            VALUE "InternalName", "MikuDanceStudioNG\0"
            VALUE "OriginalFilename", "MikuDanceStudioNG.exe\0"
            VALUE "ProductName", "MikuDanceStudio-NG\0"
            VALUE "ProductVersion", "@MDS_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
