<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="io.github.jstzwj.mikudancestudiong"
          android:versionName="@MDS_VERSION@" android:versionCode="-- %%INSERT_VERSION_CODE%% --">
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00403000" android:required="true" />
    <application android:label="MikuDanceStudio-NG" android:icon="@drawable/icon"
                 android:theme="@style/MdsEditorTheme" android:hardwareAccelerated="true"
                 android:allowBackup="false" android:extractNativeLibs="true">
        <activity android:name="io.github.jstzwj.mikudancestudiong.EditorActivity"
                  android:label="MikuDanceStudio-NG" android:exported="true"
                  android:screenOrientation="sensorLandscape"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|density|keyboard|keyboardHidden|navigation|locale|layoutDirection|fontScale|mcc|mnc|colorMode"
                  android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="-- %%INSERT_APP_LIB_NAME%% --" />
            <meta-data android:name="android.app.arguments" android:value="-- %%INSERT_APP_ARGUMENTS%% --" />
        </activity>
    </application>
</manifest>
